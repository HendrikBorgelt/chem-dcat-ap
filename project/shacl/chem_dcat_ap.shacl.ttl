@prefix AFE: <http://purl.allotrope.org/ontologies/equipment#AFE_> .
@prefix AFR: <http://purl.allotrope.org/ontologies/result#AFR_> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix CHEBI: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix CHEMINF: <http://semanticscience.org/resource/CHEMINF_> .
@prefix CHMO: <http://purl.obolibrary.org/obo/CHMO_> .
@prefix ENVO: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix PATO: <http://purl.obolibrary.org/obo/PATO_> .
@prefix PROCO: <http://purl.obolibrary.org/obo/PROCO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix RXNO: <http://purl.obolibrary.org/obo/RXNO_> .
@prefix SIO: <http://semanticscience.org/resource/SIO_> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix chemdcatap: <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap_plus: <https://w3id.org/nfdi-de/dcat-ap-plus/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcatap_plus:ActivityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: had_input_activity" ;
            sh:minCount 1 ;
            sh:path prov:wasInformedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: carried_out_by" ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_input_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_output_entity" ;
            sh:minCount 1 ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_entity" ;
            sh:minCount 1 ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_output_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:generated ;
            sh:severity sh:Warning ] ;
    sh:targetClass prov:Activity .

dcatap_plus:AgentShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: type" ;
            sh:minCount 1 ;
            sh:path dcterms:type ;
            sh:severity sh:Warning ] ;
    sh:targetClass foaf:Agent .

dcatap_plus:AgenticEntityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ] ;
    sh:targetClass prov:Agent .

dcatap_plus:AnalysisDatasetShape a sh:NodeShape ;
    rdfs:comment "A Dataset that was generated by an analysis of some previously generated data. For example, a dataset that contains the data of an assignment of a chemical structure to a sample based on the spectral data obtained from the sample is an AnalyticalDataset." ;
    sh:property [ sh:description "is_about_entity: A slot to provide the EvaluatedEntity a Dataset is about.; is_about_activity: A slot to provide the EvaluatedActivity a Dataset is about." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedEntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] [ sh:node dcatap_plus:EvaluatedActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 37 ;
            sh:path dcterms:subject ],
        [ sh:description "A web page that provides access to the Dataset, its Distributions and/or additional information." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcat:landingPage ],
        [ sh:description "An entity responsible for producing the dataset." ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:creator ],
        [ sh:description "A page or document about this Dataset." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path foaf:page ],
        [ sh:description "An implementing rule or other specification." ;
            sh:node dcatap_plus:StandardShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:class prov:Activity ;
            sh:description "An activity that generated, or provides the business context for, the creation of the dataset." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DataAnalysisShape ;
            sh:nodeKind sh:IRI ;
            sh:order 35 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "A related resource." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the differences between this version and a previous version of the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path adms:versionNotes ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset that is a version, edition, or adaptation of the described Dataset." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcat:hasVersion ],
        [ sh:description "A type of the Dataset." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path dcterms:type ],
        [ sh:description "A dataset series of which the dataset is part." ;
            sh:node dcatap_plus:DatasetSeriesShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcat:inSeries ],
        [ sh:datatype xsd:string ;
            sh:description "A keyword or tag describing the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcat:keyword ],
        [ sh:datatype xsd:string ;
            sh:description "The version indicator (name or identifier) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path dcat:version ],
        [ sh:description "A statement about the lineage of a Dataset." ;
            sh:node dcatap_plus:ProvenanceStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path dcterms:provenance ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset from which the described Dataset is derived." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dcterms:source ],
        [ sh:description "A related resource, such as a publication, that references, cites, or otherwise points to the dataset." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:isReferencedBy ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:datatype xsd:string ;
            sh:description "The main identifier for the Dataset, e.g. the URI or other unique identifier in the context of the Catalogue." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dcterms:title ],
        [ sh:description "A sample distribution of the dataset." ;
            sh:node dcatap_plus:DistributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path adms:sample ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path dcatap_plus:id ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:issued ],
        [ sh:description "An available Distribution for the Dataset." ;
            sh:node dcatap_plus:DistributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcat:distribution ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Dataset was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:modified ],
        [ sh:description "A secondary identifier of the Dataset" ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path adms:identifier ],
        [ sh:description "Contact information that can be used for sending comments about the Dataset." ;
            sh:node dcatap_plus:KindShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcat:contactPoint ],
        [ sh:description "A geographic region that is covered by the Dataset." ;
            sh:node dcatap_plus:LocationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dcterms:spatial ],
        [ sh:description "An Agent having some form of responsibility for the resource." ;
            sh:node dcatap_plus:AttributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path prov:qualifiedAttribution ],
        [ sh:description "A language of the Dataset." ;
            sh:node dcatap_plus:LinguisticSystemShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path dcterms:language ],
        [ sh:description "The legislation that mandates the creation or management of the Dataset." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:description "The frequency at which the Dataset is updated." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:FrequencyShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:accrualPeriodicity ],
        [ sh:description "An entity (organisation) responsible for making the Dataset available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path dcterms:publisher ],
        [ sh:description "Information that indicates whether the Dataset is publicly accessible, has access restrictions or is not public." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:RightsStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:accessRights ],
        [ sh:description "A category of the Dataset." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path dcat:theme ],
        [ sh:description "A description of a relationship with another resource." ;
            sh:node dcatap_plus:RelationshipShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path dcat:qualifiedRelation ],
        [ sh:description "A temporal period that the Dataset covers." ;
            sh:node dcatap_plus:PeriodOfTimeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path dcterms:temporal ] .

dcatap_plus:AnalysisDatasetShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommendations for EvaluatedEntity (via is_about_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ] [ sh:node dcatap_plus:EvaluatedEntityShapeRecommendations ] ) ;
            sh:path dcterms:subject ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: contact_point" ;
            sh:minCount 1 ;
            sh:path dcat:contactPoint ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: keyword" ;
            sh:minCount 1 ;
            sh:path dcat:keyword ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for DataAnalysis (via was_generated_by) not met" ;
            sh:node dcatap_plus:DataAnalysisShapeRecommendations ;
            sh:path prov:wasGeneratedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: theme" ;
            sh:minCount 1 ;
            sh:path dcat:theme ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedActivity (via is_about_activity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ] [ sh:node dcatap_plus:EvaluatedActivityShapeRecommendations ] ) ;
            sh:path dcterms:subject ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: is_about_activity" ;
            sh:path dcterms:subject ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: is_about_entity" ;
            sh:path dcterms:subject ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedEntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ;
            sh:severity sh:Warning ] .

dcatap_plus:AnyShape a sh:NodeShape ;
    rdfs:comment "This abstract class is needed to create the union of Dataset, DatasetSeries, Catalogue and DataService for the range of the slot [primary_topic](https://nfdi-de.github.io/chem-dcat-ap/elements/primary_topic/)." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass linkml:Any .

dcatap_plus:CatalogueRecordShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: listing_date" ;
            sh:minCount 1 ;
            sh:path dcterms:issued ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: change_type" ;
            sh:minCount 1 ;
            sh:path adms:status ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: application_profile" ;
            sh:minCount 1 ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:CatalogRecord .

dcatap_plus:CatalogueShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: language" ;
            sh:minCount 1 ;
            sh:path dcterms:language ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: themes" ;
            sh:minCount 1 ;
            sh:path dcat:themeTaxonomy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: homepage" ;
            sh:minCount 1 ;
            sh:path foaf:homepage ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: modification_date" ;
            sh:minCount 1 ;
            sh:path dcterms:modified ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: release_date" ;
            sh:minCount 1 ;
            sh:path dcterms:issued ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Catalog .

dcatap_plus:ClassifierMixinShape a sh:NodeShape ;
    rdfs:comment "A mixin with which an entity of this schema can be classified via an additional rdf:type or dcterms:type assertion." ;
    sh:property [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( AFE:0000153 AFR:0002409 BFO:0000040 CHEBI:23367 CHEBI:33250 CHMO:0002820 CHMO:0002855 ENVO:01001405 NCIT:C48810 OBI:0000747 PROCO:0000029 qudt:Quantity CHEMINF:000018 CHEMINF:000042 CHEMINF:000059 CHEMINF:000107 CHEMINF:000113 SIO:001089 SIO:001378 SIO:001406 SIO:010344 SIO:010345 SIO:010411 SIO:010417 prov:Activity prov:Agent prov:Entity prov:Location prov:Plan prov:SoftwareAgent dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 1 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( AFE:0000153 AFR:0002409 BFO:0000040 CHEBI:23367 CHEBI:33250 CHMO:0002820 CHMO:0002855 ENVO:01001405 NCIT:C48810 OBI:0000747 PROCO:0000029 qudt:Quantity CHEMINF:000018 CHEMINF:000042 CHEMINF:000059 CHEMINF:000107 CHEMINF:000113 SIO:001089 SIO:001378 SIO:001406 SIO:010344 SIO:010345 SIO:010411 SIO:010417 prov:Activity prov:Agent prov:Entity prov:Location prov:Plan prov:SoftwareAgent dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass dcatap_plus:ClassifierMixin .

dcatap_plus:ClassifierMixinShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcatap_plus:ClassifierMixin .

dcatap_plus:DataServiceShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: contact_point" ;
            sh:minCount 1 ;
            sh:path dcat:contactPoint ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: keyword" ;
            sh:minCount 1 ;
            sh:path dcat:keyword ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: conforms_to" ;
            sh:minCount 1 ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: theme" ;
            sh:minCount 1 ;
            sh:path dcat:theme ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: endpoint_description" ;
            sh:minCount 1 ;
            sh:path dcat:endpointDescription ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:DataService .

dcatap_plus:DatasetShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: contact_point" ;
            sh:minCount 1 ;
            sh:path dcat:contactPoint ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: keyword" ;
            sh:minCount 1 ;
            sh:path dcat:keyword ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedEntity (via is_about_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ] [ sh:node dcatap_plus:EvaluatedEntityShapeRecommendations ] ) ;
            sh:path dcterms:subject ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for DataGeneratingActivity (via was_generated_by) not met" ;
            sh:node dcatap_plus:DataGeneratingActivityShapeRecommendations ;
            sh:path prov:wasGeneratedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: theme" ;
            sh:minCount 1 ;
            sh:path dcat:theme ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: is_about_activity" ;
            sh:path dcterms:subject ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedActivity (via is_about_activity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ] [ sh:node dcatap_plus:EvaluatedActivityShapeRecommendations ] ) ;
            sh:path dcterms:subject ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: is_about_entity" ;
            sh:path dcterms:subject ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedEntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Dataset .

dcatap_plus:DistributionShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: availability" ;
            sh:minCount 1 ;
            sh:path <dcatap:availability> ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: format" ;
            sh:minCount 1 ;
            sh:path dcterms:format ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: description" ;
            sh:minCount 1 ;
            sh:path dcterms:description ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Distribution .

dcatap_plus:LicenseDocumentShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: type" ;
            sh:minCount 1 ;
            sh:path dcterms:type ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcterms:LicenseDocument .

dcatap_plus:LocationShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: centroid" ;
            sh:minCount 1 ;
            sh:path dcat:centroid ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: bbox" ;
            sh:minCount 1 ;
            sh:path dcat:bbox ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcterms:Location .

dcatap_plus:PeriodOfTimeShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: end_date" ;
            sh:minCount 1 ;
            sh:path dcat:endDate ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: start_date" ;
            sh:minCount 1 ;
            sh:path dcat:startDate ;
