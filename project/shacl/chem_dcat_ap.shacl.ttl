        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( BFO:0000040 PROCO:0000029 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ) ;
            sh:order 10 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( BFO:0000040 PROCO:0000029 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ] ] ;
    sh:targetClass PROCO:0000029 .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/YieldShape> a sh:NodeShape ;
    rdfs:comment "A dimensionless physical quantity describing the fraction of a product B that is formed from a reactant A taking into account the stoichiometry. If A fully reacts to B without side-reactions, the yield of product B is 1 (or 100 %)." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The slot to provide the literal value of the QuantitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( CHMO:0002855 qudt:Quantity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 6 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( CHMO:0002855 qudt:Quantity dcatap_plus:ClassifierMixin ) ] ] ],
        [ sh:description "The type of quality that is quantifiable according to the QUDT ontology." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path qudt:hasQuantityKind ] ;
    sh:targetClass CHMO:0002855 .

dcatap_plus:AnalysisSourceDataShape a sh:NodeShape ;
    rdfs:comment "Information that was evaluated within a DataAnalysis." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path adms:identifier ],
        [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 5 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:class prov:Activity ;
            sh:description "A slot to provide the Activity which created the AnalysisSourceData." ;
            sh:node dcatap_plus:DataGeneratingActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "A slot to provide a part of the Entity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Entity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 9 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Entity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:CatalogueShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Catalogue](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Catalogue)" ;
    sh:property [ sh:description "A Catalogue Record that is part of the Catalogue." ;
            sh:node dcatap_plus:CatalogueRecordShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcat:record ],
        [ sh:description "A site or end-point (Data Service) that is listed in the Catalogue." ;
            sh:node dcatap_plus:DataServiceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path dcat:service ],
        [ sh:description "A knowledge organization system used to classify the Resources that are in the Catalogue." ;
            sh:node dcatap_plus:ConceptSchemeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcat:themeTaxonomy ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Catalogue was modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:modified ],
        [ sh:description "A web page that acts as the main page for the Catalogue." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path foaf:homepage ],
        [ sh:description "An entity responsible for the creation of the catalogue." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Catalogue." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:description "The legislation that mandates the creation or management of the Catalog." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Catalogue." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:title ],
        [ sh:description "An entity (organisation) responsible for making the Catalogue available." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path dcterms:publisher ],
        [ sh:description "A catalogue whose contents are of interest in the context of this catalogue." ;
            sh:node dcatap_plus:CatalogueShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcat:catalog ],
        [ sh:description "A geographical area covered by the Catalogue." ;
            sh:node dcatap_plus:LocationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:spatial ],
        [ sh:description "A language used in the textual metadata describing titles, descriptions, etc. of the Datasets in the Catalogue." ;
            sh:node dcatap_plus:LinguisticSystemShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:language ],
        [ sh:description "A statement that specifies rights associated with the Catalogue." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:RightsStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:rights ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Catalogue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dcterms:issued ],
        [ sh:description "A related Catalogue that is part of the described Catalogue." ;
            sh:node dcatap_plus:CatalogueShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:class dcat:Dataset ;
            sh:description "A Dataset that is part of the Catalogue." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcat:dataset ],
        [ sh:description "A temporal period that the Catalogue covers." ;
            sh:node dcatap_plus:PeriodOfTimeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path dcterms:temporal ],
        [ sh:description "A licence under which the Catalogue can be used or reused." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:LicenseDocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:license ] ;
    sh:targetClass dcat:Catalog .

dcatap_plus:DataServiceShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:DataService](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#DataService)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Data Service." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Data Service." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "A keyword or tag describing the Data Service." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcat:keyword ],
        [ sh:description "An established (technical) standard to which the Data Service conforms." ;
            sh:node dcatap_plus:StandardShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:description "The root location or primary endpoint of the service (an IRI)." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcat:endpointURL ],
        [ sh:description "A web page that provides access to the Data Service and/or additional information." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcat:landingPage ],
        [ sh:description "A page or document about this Data Service" ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path foaf:page ],
        [ sh:description "A licence under which the Data service is made available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:LicenseDocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:license ],
        [ sh:description "A description of the services available via the end-points, including their operations, parameters etc." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcat:endpointDescription ],
        [ sh:class dcat:Dataset ;
            sh:description "This property refers to a collection of data that this data service can distribute." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcat:servesDataset ],
        [ sh:description "Contact information that can be used for sending comments about the Data Service." ;
            sh:node dcatap_plus:KindShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcat:contactPoint ],
        [ sh:description "An entity (organisation) responsible for making the Data Service available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcterms:publisher ],
        [ sh:description "The legislation that mandates the creation or management of the Data Service." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:description "Information regarding access or restrictions based on privacy, security, or other policies." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:RightsStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:accessRights ],
        [ sh:description "The structure that can be returned by querying the endpointURL." ;
            sh:node dcatap_plus:MediaTypeOrExtentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:format ],
        [ sh:description "A category of the Data Service." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcat:theme ] ;
    sh:targetClass dcat:DataService .

dcatap_plus:LicenseDocumentShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:LicenseDocument](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LicenseDocument)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcatap_plus:id ],
        [ sh:description "A type of licence, e.g. indicating 'public domain' or 'royalties required'." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:type ] ;
    sh:targetClass dcterms:LicenseDocument .

dcatap_plus:MediaTypeShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:MediaType](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#MediaType)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:MediaType .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/MolarEquivalentShapeRecommendations> a sh:NodeShape ;
    sh:property [ sh:message "Recommended: unit" ;
            sh:minCount 1 ;
            sh:path qudt:unit ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ] .

dcatap_plus:AttributionShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Attribution](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Attribution)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
