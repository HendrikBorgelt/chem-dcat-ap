        [ sh:message "Recommendations for DataGeneratingActivity (via was_generated_by) not met" ;
            sh:node dcatap_plus:DataGeneratingActivityShapeRecommendations ;
            sh:path prov:wasGeneratedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via part_of) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path dcterms:isPartOf ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via has_part) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path dcterms:hasPart ;
            sh:severity sh:Warning ] .

dcatap_plus:ChecksumAlgorithmShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:ChecksumAlgorithm](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ChecksumAlgorithm)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <spdx:ChecksumAlgorithm> .

dcatap_plus:ChecksumShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Checksum](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Checksum)" ;
    sh:property [ sh:datatype xsd:hexBinary ;
            sh:description "A lower case hexadecimal encoded digest value produced using a specific algorithm." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <spdx:checksumValue> ;
            sh:pattern "([0-9a-fA-F]{2})*" ],
        [ sh:description "The algorithm used to produce the subject Checksum." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:ChecksumAlgorithmShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <spdx:algorithm> ] ;
    sh:targetClass <spdx:Checksum> .

dcatap_plus:ConceptSchemeShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:ConceptScheme](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name of the concept scheme." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass skos:ConceptScheme .

dcatap_plus:DataAnalysisShape a sh:NodeShape ;
    rdfs:comment "An Activity that evaluates the data produced by another Activity." ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 10 ;
            sh:path dcterms:relation ],
        [ sh:name "realized_plan" ;
            sh:path prov:used ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:PlanShape ] ],
        [ sh:description "evaluated_activity: The slot to specify the Activity about which the DataGeneratingActivity produced information.; had_input_activity: The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] [ sh:node dcatap_plus:ActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 1 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "evaluated_entity: A slot to provide the data that was analysed by the DataAnalysis.; realized_plan: The slot to specify the Plan (i.e. directive information or procedure) that was realized by an Activity.; had_input_entity: The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:or ( [ sh:class prov:Entity ;
                        sh:node dcatap_plus:AnalysisSourceDataShape ] [ sh:node dcatap_plus:PlanShape ] [ sh:node dcatap_plus:EntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ) ;
            sh:order 0 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:SurroundingShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:atLocation ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 13 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:DataAnalysisShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommendations for Entity (via had_input_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ] [ sh:node dcatap_plus:EntityShapeRecommendations ] ) ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: evaluated_activity" ;
            sh:path prov:wasInformedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: carried_out_by" ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for AnalysisSourceData (via evaluated_entity) not met" ;
            sh:or ( [ sh:not [ sh:class prov:Entity ] ] [ sh:node dcatap_plus:AnalysisSourceDataShapeRecommendations ] ) ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: evaluated_entity" ;
            sh:path prov:used ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class prov:Entity ;
                    sh:node dcatap_plus:AnalysisSourceDataShape ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_output_entity" ;
            sh:minCount 1 ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedActivity (via evaluated_activity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ] [ sh:node dcatap_plus:EvaluatedActivityShapeRecommendations ] ) ;
            sh:path prov:wasInformedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_entity" ;
            sh:path prov:used ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_output_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_activity" ;
            sh:path prov:wasInformedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:ActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ] .

dcatap_plus:DeviceShape a sh:NodeShape ;
    rdfs:comment "A material instrument that is designed to perform a function primarily by means of its mechanical or electrical nature." ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 4 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide a secondary identifier for a Device." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify parts of a Device that are themselves Devices." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] ) ;
            sh:order 5 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to provide the AgenticEntity of which theAgenticEntity is a part." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 6 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( AFE:0000153 prov:Agent dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 8 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( AFE:0000153 prov:Agent dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:DeviceShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ] .

dcatap_plus:GeometryShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Geometry](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Geometry)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <locn:Geometry> .

dcatap_plus:PolicyShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Policy](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Policy)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <odrl:Policy> .

dcatap_plus:RoleShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Role](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Role)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcat:Role .

dcatap_plus:SoftwareShape a sh:NodeShape ;
    rdfs:comment "An instrument composed of a series of instructions that can be interpreted by or directly executed by a computer." ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 4 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide a secondary identifier for a Software." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to provide the AgenticEntity of which theAgenticEntity is a part." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 6 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify parts of a Software that are themselves Software." ;
            sh:node dcatap_plus:SoftwareShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Agent prov:SoftwareAgent dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 8 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Agent prov:SoftwareAgent dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass prov:SoftwareAgent .

chemdcatap:ReactionMonitoringShape a sh:NodeShape ;
    rdfs:comment "A DataGeneratingActivity that produces data about a ChemicalReaction, such as reaction monitoring, experimental documentation, or a combined recording-and-evaluation workflow. This is a coarse-grained convenience shape that does not distinguish between raw experimental recording and subsequent data evaluation. Domain-specific sub-profiles that need this distinction should define their own DataGeneratingActivity subclasses and use the DCAT-AP+ DataAnalysis chain to separate raw data from derived results." ;
    sh:property [ sh:description "evaluated_activity: The slot to specify the ChemicalReaction being recorded.; had_input_activity: The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ChemicalReactionShape> ] [ sh:node dcatap_plus:ActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 1 ;
            sh:path prov:wasInformedBy ],
        [ sh:name "realized_plan" ;
            sh:path prov:used ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:PlanShape ] ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 10 ;
            sh:path dcterms:relation ],
        [ sh:description "evaluated_entity: The slot to specify the Entity about which the DataGeneratingActivity produced information.; realized_plan: The slot to specify the Plan (i.e. directive information or procedure) that was realized by an Activity.; had_input_entity: The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedEntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] [ sh:node dcatap_plus:PlanShape ] [ sh:node dcatap_plus:EntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ) ;
            sh:order 0 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:SurroundingShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:atLocation ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 13 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] .

chemdcatap:ReactionMonitoringShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommendations for Entity (via had_input_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ] [ sh:node dcatap_plus:EntityShapeRecommendations ] ) ;
