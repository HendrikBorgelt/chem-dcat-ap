<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/CatalystShape> a sh:NodeShape ;
    rdfs:comment "A ChemicalSubstance or MaterialEntity that initiates or accelerates a ChemicalReaction without itself being affected." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path skos:altLabel ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 6 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:description "has_molar_equivalent: A slot to provide the MolarEquivalent of a ChemicalSubstance, such as the DissolvingSubstance, Starting Material or Reactant, within the context of a chemical reaction.; has_concentration: The slot to provide the Concentration of a ChemicalSubstance.; has_ph_value: The slot to provide the PHValue of a ChemicalSubstance.; has_amount: The slot to provide the AmountConcentration of a ChemicalSubstance.; has_physical_state: The slot to specify the physical state of a MaterialEntity.; has_temperature: The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity.; has_mass: The slot to provide the Mass of a MaterialEntity.; has_volume: The slot to provide the Volume of a MaterialEntity.; has_density: The slot to provide the Density of a MaterialEntity.; has_pressure: The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:or ( [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/MolarEquivalentShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ConcentrationShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/PHValueShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/AmountOfSubstanceShape> ] [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShape> ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/VolumeShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/DensityShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/PressureShape> ] ) ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcatap_plus:id ],
        [ sh:description "A slot to provide a secondary identifier for an Instrument." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path adms:identifier ],
        [ sh:name "has_physical_state" ;
            sh:path SIO:000008 ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( SIO:010344 prov:Agent dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ) ;
            sh:order 10 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( SIO:010344 prov:Agent dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ] ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to provide the AgenticEntity of which theAgenticEntity is a part." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 8 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to specify parts of an AgenticEntity that are themselves AgenticEntities." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to provide the chemical entities of which a ChemicalSubstance is composed of." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalEntityShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path BFO:0000051 ] ;
    sh:targetClass SIO:010344 .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ChemicalProductShape> a sh:NodeShape ;
    rdfs:comment "A chemical substance that is produced by a ChemicalReaction." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:altLabel ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 7 ;
            sh:path dcterms:relation ],
        [ sh:description "has_concentration: The slot to provide the Concentration of a ChemicalSubstance.; has_ph_value: The slot to provide the PHValue of a ChemicalSubstance.; has_amount: The slot to provide the AmountConcentration of a ChemicalSubstance.; has_physical_state: The slot to specify the physical state of a MaterialEntity.; has_temperature: The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity.; has_mass: The slot to provide the Mass of a MaterialEntity.; has_volume: The slot to provide the Volume of a MaterialEntity.; has_density: The slot to provide the Density of a MaterialEntity.; has_pressure: The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ConcentrationShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/PHValueShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/AmountOfSubstanceShape> ] [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShape> ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/VolumeShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/DensityShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/PressureShape> ] ) ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:name "has_physical_state" ;
            sh:path SIO:000008 ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide a secondary identifier of the Entity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( BFO:0000040 NCIT:C48810 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ) ;
            sh:order 10 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( BFO:0000040 NCIT:C48810 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ] ],
        [ sh:description "composed_of: The slot to provide the chemical entities of which a ChemicalSubstance is composed of.; has_part: The slot to provide the parts of a MaterialEntity." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalEntityShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialEntityShape> ] ) ;
            sh:order 1 ;
            sh:path BFO:0000051 ] ;
    sh:targetClass NCIT:C48810 .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/PercentageOfTotalShapeRecommendations> a sh:NodeShape ;
    sh:property [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: unit" ;
            sh:minCount 1 ;
            sh:path qudt:unit ;
            sh:severity sh:Warning ] .

dcatap_plus:CatalogueRecordShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:CatalogueRecord](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A free-text account of the record. This property can be repeated for parallel language versions of the description." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Catalogue Record." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:description "An Application Profile that the Catalogued Resource&#39;s metadata conforms to." ;
            sh:node dcatap_plus:StandardShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:conformsTo ],
        [ sh:datatype xsd:date ;
            sh:description "The date on which the description of the Resource was included in the Catalogue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:issued ],
        [ sh:description "The original metadata that was used in creating metadata for the Dataset, Data Service or Dataset Series." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:CatalogueRecordShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Catalogue entry was changed or modified." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:modified ],
        [ sh:description "A language used in the textual metadata describing titles, descriptions, etc. of the Catalogued Resource." ;
            sh:node dcatap_plus:LinguisticSystemShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:language ],
        [ sh:description "A link to the Dataset, Data service or Catalog described in the record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:node dcatap_plus:CatalogueShape ] [ sh:class dcat:Dataset ;
                        sh:node dcatap_plus:DatasetShape ] [ sh:node dcatap_plus:DatasetSeriesShape ] [ sh:node dcatap_plus:DataServiceShape ] ) ;
            sh:order 6 ;
            sh:path foaf:primaryTopic ],
        [ sh:description "The status of the catalogue record in the context of editorial flow of the dataset and data service descriptions." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path adms:status ] ;
    sh:targetClass dcat:CatalogRecord .

dcatap_plus:DataGeneratingActivityShape a sh:NodeShape ;
    rdfs:comment "An Activity (process) that has the objective to produce information (in form of a dataset) about another Activity or Entity." ;
    sh:property [ sh:name "realized_plan" ;
            sh:path prov:used ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:PlanShape ] ],
        [ sh:description "evaluated_entity: The slot to specify the Entity about which the DataGeneratingActivity produced information.; realized_plan: The slot to specify the Plan (i.e. directive information or procedure) that was realized by an Activity.; had_input_entity: The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedEntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] [ sh:node dcatap_plus:PlanShape ] [ sh:node dcatap_plus:EntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ) ;
            sh:order 0 ;
            sh:path prov:used ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 10 ;
            sh:path dcterms:relation ],
        [ sh:description "evaluated_activity: The slot to specify the Activity about which the DataGeneratingActivity produced information.; had_input_activity: The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] [ sh:node dcatap_plus:ActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 1 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:SurroundingShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:atLocation ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 13 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:DataGeneratingActivityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommendations for Entity (via had_input_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ] [ sh:node dcatap_plus:EntityShapeRecommendations ] ) ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedActivity (via evaluated_activity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ] [ sh:node dcatap_plus:EvaluatedActivityShapeRecommendations ] ) ;
            sh:path prov:wasInformedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for EvaluatedEntity (via evaluated_entity) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ] [ sh:node dcatap_plus:EvaluatedEntityShapeRecommendations ] ) ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: evaluated_entity" ;
            sh:path prov:used ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedEntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: carried_out_by" ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_output_entity" ;
            sh:minCount 1 ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: evaluated_activity" ;
            sh:path prov:wasInformedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EvaluatedActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_output_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_activity" ;
            sh:path prov:wasInformedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:ActivityShape ;
                    sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_entity" ;
            sh:path prov:used ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:EntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ;
            sh:severity sh:Warning ] .

dcatap_plus:MediaTypeOrExtentShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:MediaTypeOrExtent](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#MediaTypeOrExtent)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:MediaTypeOrExtent .

dcatap_plus:TimeInstantShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:TimeInstant](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#TimeInstant)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass time:Instant .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/IUPACNameShape> a sh:NodeShape ;
    rdfs:comment "A systematic name which is formulated according to the rules and recommendations for chemical nomenclature set out by the International Union of Pure and Applied Chemistry (IUPAC)." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
