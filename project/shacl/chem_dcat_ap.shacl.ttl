            sh:qualifiedValueShape [ sh:node dcatap_plus:EntityShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ;
            sh:severity sh:Warning ] .

chemdcatap:SubstanceSampleCharacterizationShape a sh:NodeShape ;
    rdfs:comment "A DataGeneratingActivity that produces data about a SubstanceSample, such as a spectroscopic measurement, a physical property determination, or a combined measurement-and-analysis workflow. This is a coarse-grained convenience shape that does not distinguish between raw data acquisition and subsequent data processing or analysis. Domain-specific sub-profiles that need this distinction should define their own DataGeneratingActivity subclasses and use the DCAT-AP+ DataAnalysis chain to separate raw measurement from derived results." ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 10 ;
            sh:path dcterms:relation ],
        [ sh:name "realized_plan" ;
            sh:path prov:used ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:PlanShape ] ],
        [ sh:description "evaluated_activity: The slot to specify the Activity about which the DataGeneratingActivity produced information.; had_input_activity: The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] [ sh:node dcatap_plus:ActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 1 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "evaluated_entity: The slot to specify the SubstanceSample being characterized.; realized_plan: The slot to specify the Plan (i.e. directive information or procedure) that was realized by an Activity.; had_input_entity: The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:or ( [ sh:class SIO:001378 ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/SubstanceSampleShape> ] [ sh:node dcatap_plus:PlanShape ] [ sh:node dcatap_plus:EntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ] ) ;
            sh:order 0 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:SurroundingShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:atLocation ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 13 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] .

