        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The slot to provide the literal value of the QuantitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 6 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ] ],
        [ sh:description "The type of quality that is quantifiable according to the QUDT ontology." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path qudt:hasQuantityKind ] .

<https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> a sh:NodeShape ;
    rdfs:comment "A physical quantity that quantitatively expresses the attribute of hotness or coldness." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The slot to provide the literal value of the QuantitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 6 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ] ],
        [ sh:description "The type of quality that is quantifiable according to the QUDT ontology." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path qudt:hasQuantityKind ] .

dcatap_plus:ActivityShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Activity](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Activity)" ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 9 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 5 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 4 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 10 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 6 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 12 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ] ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 8 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass prov:Activity .

dcatap_plus:IdentifierShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Identifier](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Identifier)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "A string that is an identifier in the context of the identifier scheme referenced by its datatype." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:notation ] ;
    sh:targetClass adms:Identifier .

dcatap_plus:EntityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ] .

dcatap_plus:EntityShape a sh:NodeShape ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary." ;
    sh:property [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 4 ;
            sh:path dcterms:relation ],
        [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 6 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcatap_plus:id ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "A slot to provide a secondary identifier of the Entity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 5 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( BFO:0000040 CHEBI:23367 CHEBI:33250 NCIT:C48810 OBI:0000747 PROCO:0000029 SIO:001378 SIO:010411 prov:Entity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 8 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( BFO:0000040 CHEBI:23367 CHEBI:33250 NCIT:C48810 OBI:0000747 PROCO:0000029 SIO:001378 SIO:010411 prov:Entity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:QuantitativeAttributeShape a sh:NodeShape ;
    rdfs:comment "A quantifiable piece of information that is attributed to an Entity, Activity or AgenticEntity." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The slot to provide the literal value of the QuantitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:description "The type of quality that is quantifiable according to the QUDT ontology." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path qudt:hasQuantityKind ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( AFR:0002409 CHMO:0002820 CHMO:0002855 qudt:Quantity SIO:001089 SIO:001406 dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 6 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( AFR:0002409 CHMO:0002820 CHMO:0002855 qudt:Quantity SIO:001089 SIO:001406 dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass qudt:Quantity .

dcatap_plus:QualitativeAttributeShape a sh:NodeShape ;
    rdfs:comment "A piece of information that is attributed to an Entity, Activity or AgenticEntity." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( CHEMINF:000018 CHEMINF:000042 CHEMINF:000059 CHEMINF:000107 CHEMINF:000113 prov:Entity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 4 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( CHEMINF:000018 CHEMINF:000042 CHEMINF:000059 CHEMINF:000107 CHEMINF:000113 prov:Entity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:DefinedTermShape a sh:NodeShape ;
    rdfs:comment "A word, name, acronym or phrase that is defined in a controlled vocabulary (CV) and that is used to provide an additional rdf:type or dcterms:type of a class within this schema." ;
    sh:property [ sh:description "The URL of the controlled vocabulary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:inDefinedTermSet ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ] ;
    sh:targetClass schema1:DefinedTerm .

