dcatap_plus:RelationshipShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Relationship](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Relationship)" ;
    sh:property [ sh:description "A function of an entity or agent with respect to another entity or resource." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:RoleShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcat:hadRole ],
        [ sh:description "A resource related to the source resource." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcterms:relation ] ;
    sh:targetClass dcat:Relationship .

dcatap_plus:SurroundingShape a sh:NodeShape ;
    rdfs:comment "The surrounding in which the dataset creating activity took place (e.g. a lab)." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( ENVO:01001405 prov:Location dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 3 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( ENVO:01001405 prov:Location dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass prov:Location .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/SubstanceSampleShape> a sh:NodeShape ;
    rdfs:comment "A MaterialSample derived from a chemical substance that is of interest in an analytical procedure." ;
    sh:property [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:altLabel ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 9 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:name "has_physical_state" ;
            sh:path SIO:000008 ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] ],
        [ sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 4 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "has_concentration: The slot to provide the Concentration of a ChemicalSubstance.; has_ph_value: The slot to provide the PHValue of a ChemicalSubstance.; has_amount: The slot to provide the AmountConcentration of a ChemicalSubstance.; has_physical_state: The slot to specify the physical state of a MaterialEntity.; has_temperature: The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity.; has_mass: The slot to provide the Mass of a MaterialEntity.; has_volume: The slot to provide the Volume of a MaterialEntity.; has_density: The slot to provide the Density of a MaterialEntity.; has_pressure: The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ConcentrationShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/PHValueShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/AmountOfSubstanceShape> ] [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShape> ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/VolumeShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/DensityShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/PressureShape> ] ) ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path adms:identifier ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcatap_plus:id ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to specify the MaterialEntity or MaterialSample from which the MaterialSample was created." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 2 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "The slot to provide the chemical entities of which a ChemicalSubstance is composed of." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalEntityShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path BFO:0000051 ],
        [ sh:description "A slot to provide a part of the Entity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 10 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( OBI:0000747 SIO:001378 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ) ;
            sh:order 13 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( OBI:0000747 SIO:001378 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ] ] ;
    sh:targetClass SIO:001378 .

dcatap_plus:DatasetSeriesShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:DatasetSeries](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#DatasetSeries)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Dataset Series." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Dataset Series." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:description "An entity (organisation) responsible for ensuring the coherency of the Dataset Series " ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcterms:publisher ],
        [ sh:description "The legislation that mandates the creation or management of the Dataset Series." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Dataset Series was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:modified ],
        [ sh:description "Contact information that can be used for sending comments about the Dataset Series." ;
            sh:node dcatap_plus:KindShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcat:contactPoint ],
        [ sh:description "A geographic region that is covered by the Dataset Series." ;
            sh:node dcatap_plus:LocationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:spatial ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Dataset Series." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:issued ],
        [ sh:description "The frequency at which the Dataset Series is updated." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:FrequencyShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:accrualPeriodicity ],
        [ sh:description "A temporal period that the Dataset Series covers." ;
            sh:node dcatap_plus:PeriodOfTimeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:temporal ] ;
    sh:targetClass dcat:DatasetSeries .

dcatap_plus:EvaluatedEntityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via part_of) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path dcterms:isPartOf ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via has_part) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path dcterms:hasPart ;
            sh:severity sh:Warning ] .

dcatap_plus:FrequencyShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Frequency](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Frequency)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:Frequency .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ChemicalReactionShape> a sh:NodeShape ;
    rdfs:comment "A process that leads to the transformation of one set of chemical substances to another and that is the subject matter of a DataGeneratingActivity." ;
    sh:property [ sh:description "related_resource: The slot to specify any Documents related to a ChemicalReaction.; has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:ResourceShape ] [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 7 ;
            sh:path dcterms:relation ],
        [ sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 15 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:duration ;
            sh:description "A slot to provide the duration of a ChemicalReaction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:duration ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:description "used_solvent: The slot to specify the chemical substance that had a solvent role (CHEBI:35223) in a ChemicalReaction.; used_reactor: The slot to specify the reactor used in a ChemicalReaction.; carried_out_by: The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/DissolvingSubstanceShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ReactorShape> ] [ sh:node dcatap_plus:AgenticEntityShape ;
                        sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ] ) ;
            sh:order 3 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "A slot to provide a secondary identifier of the EvaluatedActivity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path adms:identifier ],
        [ sh:description "has_temperature: The slot to specify the Temperature at which a ChemicalReaction takes place.; has_pressure: The slot to specify the Pressure at which a ChemicalReaction takes place.; has_yield: A slot to provide the percentage of how much of the ChemicalProduct was produced by a ChemicalReaction." ;
            sh:or ( [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/PressureShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/YieldShape> ] ) ;
            sh:order 5 ;
            sh:path SIO:000008 ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to specify the Product(s) of a ChemicalReaction." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ChemicalProductShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path RO:0004008 ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 16 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 13 ;
            sh:path prov:used ],
        [ sh:description "used_starting_material: The slot to specify the StartingMaterial(s) of a ChemicalReaction.; used_reactant: The slot to specify the Reagent(s) of a ChemicalReaction." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/StartingMaterialShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ReagentShape> ] ) ;
            sh:order 0 ;
            sh:path RO:0004009 ],
        [ sh:description "The slot to specify the Catalyst of a ChemicalReaction." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/CatalystShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path RXNO:0000425 ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 12 ;
            sh:path dcterms:hasPart ],
        [ sh:description "A slot to specify a step (part) of a ChemicalReaction that is itself a ChemicalReaction." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/ChemicalReactionShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path BFO:0000051 ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 14 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 18 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass SIO:010345 .

dcatap_plus:EvaluatedActivityShapeRecommendations a sh:NodeShape ;
    sh:property [ sh:message "Recommended: had_input_activity" ;
            sh:minCount 1 ;
            sh:path prov:wasInformedBy ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_qualitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QualitativeAttributeShape ;
                    sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: carried_out_by" ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_input_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for QualitativeAttribute (via has_qualitative_attribute) not met" ;
            sh:or ( [ sh:not [ sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] ] [ sh:node dcatap_plus:QualitativeAttributeShapeRecommendations ] ) ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_output_entity" ;
            sh:minCount 1 ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: had_input_entity" ;
            sh:minCount 1 ;
            sh:path prov:used ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ],
        [ sh:message "Recommendations for Entity (via had_output_entity) not met" ;
            sh:node dcatap_plus:EntityShapeRecommendations ;
            sh:path prov:generated ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: has_quantitative_attribute" ;
            sh:path dcterms:relation ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                    sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ;
            sh:severity sh:Warning ] .

dcatap_plus:KindShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Kind](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Kind)" ;
    sh:targetClass vcard:Kind .

dcatap_plus:LocationShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Location](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Location)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The geographic bounding box of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcat:bbox ],
        [ sh:datatype xsd:string ;
            sh:description "The geographic center (centroid) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:centroid ],
        [ sh:description "The corresponding geometry for a resource." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:GeometryShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <locn:geometry> ] ;
    sh:targetClass dcterms:Location .

dcatap_plus:PeriodOfTimeShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:PeriodOfTime](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#PeriodOfTime)" ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "The end of the period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcat:endDate ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:description "The end of a period or interval." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:TimeInstantShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path time:hasEnd ],
        [ sh:description "The beginning of a period or interval." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:TimeInstantShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path time:hasBeginning ],
        [ sh:datatype xsd:date ;
            sh:description "The start of the period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcat:startDate ] ;
    sh:targetClass dcterms:PeriodOfTime .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/reaction/MolarEquivalentShape> a sh:NodeShape ;
    rdfs:comment "A dimensionless ratio that quantifies the stoichiometric proportion of a chemical substance relative to a reference substance in a chemical reaction." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The slot to provide the literal value of the QuantitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 6 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( qudt:Quantity dcatap_plus:ClassifierMixin ) ] ] ],
        [ sh:description "The type of quality that is quantifiable according to the QUDT ontology." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path qudt:hasQuantityKind ] .

dcatap_plus:LinguisticSystemShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:LinguisticSystem](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LinguisticSystem)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:LinguisticSystem .

dcatap_plus:RightsStatementShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:RightsStatement](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#RightsStatement)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:RightsStatement .

dcatap_plus:StandardShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Standard](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Standard)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass dcterms:Standard .

<https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialEntityShape> a sh:NodeShape ;
    rdfs:comment "A material is an Entity that has some portion of matter as proper part." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:altLabel ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 6 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:title ],
        [ sh:description "has_physical_state: The slot to specify the physical state of a MaterialEntity.; has_temperature: The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity.; has_mass: The slot to provide the Mass of a MaterialEntity.; has_volume: The slot to provide the Volume of a MaterialEntity.; has_density: The slot to provide the Density of a MaterialEntity.; has_pressure: The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:or ( [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/TemperatureShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShape> ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] ) ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/VolumeShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/DensityShape> ] [ sh:class qudt:Quantity ;
                        sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/PressureShape> ] ) ;
            sh:order 1 ;
            sh:path SIO:000008 ],
        [ sh:name "has_physical_state" ;
            sh:path SIO:000008 ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:in ( PATO:0001736 PATO:0001735 PATO:0001737 PATO:0015012 ) ] ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcatap_plus:id ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 8 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "A slot to provide a secondary identifier of the Entity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path adms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to provide the parts of a MaterialEntity." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialEntityShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path BFO:0000051 ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( BFO:0000040 NCIT:C48810 PROCO:0000029 SIO:010411 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ) ;
            sh:order 10 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( BFO:0000040 NCIT:C48810 PROCO:0000029 SIO:010411 prov:Entity dcatap_plus:ClassifierMixin <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MaterialisticMixin> ) ] ] ] ;
    sh:targetClass BFO:0000040 .

dcatap_plus:DistributionShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Distribution](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Distribution)" ;
    sh:property [ sh:description "A URL that gives access to a Distribution of the Dataset." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcat:accessURL ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:description "An established schema to which the described Distribution conforms." ;
            sh:node dcatap_plus:StandardShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:conformsTo ],
        [ sh:description "A URL that is a direct link to a downloadable file in a given format." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcat:downloadURL ],
        [ sh:description "A data service that gives access to the distribution of the dataset." ;
            sh:node dcatap_plus:DataServiceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcat:accessService ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:issued ],
        [ sh:description "A page or document about this Distribution." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path foaf:page ],
        [ sh:description "The media type of the Distribution as defined in the official register of media types managed by IANA." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:MediaTypeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path dcat:mediaType ],
        [ sh:description "The legislation that mandates the creation or management of the Distribution." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:description "A language used in the Distribution." ;
            sh:node dcatap_plus:LinguisticSystemShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcterms:language ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset distribution, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:description "A mechanism that can be used to verify that the contents of a distribution have not changed." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:ChecksumShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <spdx:checksum> ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:description "A licence under which the Distribution is made available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:LicenseDocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:license ],
        [ sh:description "The file format of the Distribution." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:MediaTypeOrExtentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:format ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "The size of a Distribution in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcat:byteSize ;
            sh:pattern "([\\-+]?[0-9]+)" ],
        [ sh:description "A statement that specifies rights associated with the Distribution." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:RightsStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path dcterms:rights ],
        [ sh:description "The policy expressing the rights associated with the distribution if using the [[ODRL]] vocabulary." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:PolicyShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <odrl:hasPolicy> ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Distribution was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:modified ],
        [ sh:description "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:MediaTypeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcat:packageFormat ],
        [ sh:description "The format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:MediaTypeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcat:compressFormat ],
        [ sh:description "An indication how long it is planned to keep the Distribution of the Dataset available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <dcatap:availability> ],
        [ sh:description "The status of the distribution in the context of maturity lifecycle." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path adms:status ] ;
    sh:targetClass dcat:Distribution .

dcatap_plus:LegalResourceShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:LegalResource](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LegalResource)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ] ;
    sh:targetClass <eli:LegalResource> .

dcatap_plus:PlanShape a sh:NodeShape ;
    rdfs:comment "A piece of information that specifies how an activity has to be carried out by its agents including what kind of steps have to be taken and what kind of parameters have to be met/set." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( prov:Plan dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 3 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( prov:Plan dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass prov:Plan .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/AmountOfSubstanceShapeRecommendations> a sh:NodeShape ;
    sh:property [ sh:message "Recommended: unit" ;
            sh:minCount 1 ;
            sh:path qudt:unit ;
            sh:severity sh:Warning ],
        [ sh:message "Recommended: rdf_type" ;
            sh:minCount 1 ;
            sh:path rdf:type ;
            sh:severity sh:Warning ] .

dcatap_plus:DatasetShape a sh:NodeShape ;
    rdfs:comment "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
    sh:property [ sh:description "is_about_entity: A slot to provide the EvaluatedEntity a Dataset is about.; is_about_activity: A slot to provide the EvaluatedActivity a Dataset is about." ;
            sh:or ( [ sh:node dcatap_plus:EvaluatedEntityShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class OBI:0000747 ] [ sh:class SIO:001378 ] ) ] [ sh:node dcatap_plus:EvaluatedActivityShape ;
                        sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ] ) ;
            sh:order 37 ;
            sh:path dcterms:subject ],
        [ sh:description "A web page that provides access to the Dataset, its Distributions and/or additional information." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcat:landingPage ],
        [ sh:description "An entity responsible for producing the dataset." ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:creator ],
        [ sh:description "A page or document about this Dataset." ;
            sh:node dcatap_plus:DocumentShape ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path foaf:page ],
        [ sh:description "An implementing rule or other specification." ;
            sh:node dcatap_plus:StandardShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:description "A related resource." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the differences between this version and a previous version of the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path adms:versionNotes ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset that is a version, edition, or adaptation of the described Dataset." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcat:hasVersion ],
        [ sh:description "A type of the Dataset." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path dcterms:type ],
        [ sh:description "A dataset series of which the dataset is part." ;
            sh:node dcatap_plus:DatasetSeriesShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcat:inSeries ],
        [ sh:datatype xsd:string ;
            sh:description "A keyword or tag describing the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcat:keyword ],
        [ sh:datatype xsd:string ;
            sh:description "The version indicator (name or identifier) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path dcat:version ],
        [ sh:description "A statement about the lineage of a Dataset." ;
            sh:node dcatap_plus:ProvenanceStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path dcterms:provenance ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset from which the described Dataset is derived." ;
            sh:node dcatap_plus:DatasetShape ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dcterms:source ],
        [ sh:description "A related resource, such as a publication, that references, cites, or otherwise points to the dataset." ;
            sh:node dcatap_plus:ResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:isReferencedBy ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:datatype xsd:string ;
            sh:description "The main identifier for the Dataset, e.g. the URI or other unique identifier in the context of the Catalogue." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dcterms:title ],
        [ sh:description "A sample distribution of the dataset." ;
            sh:node dcatap_plus:DistributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path adms:sample ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path dcatap_plus:id ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:issued ],
        [ sh:class prov:Activity ;
            sh:description "An activity that generated, or provides the business context for, the creation of the dataset." ;
            sh:minCount 1 ;
            sh:node dcatap_plus:DataGeneratingActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:order 35 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "An available Distribution for the Dataset." ;
            sh:node dcatap_plus:DistributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcat:distribution ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Dataset was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:modified ],
        [ sh:description "A secondary identifier of the Dataset" ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path adms:identifier ],
        [ sh:description "Contact information that can be used for sending comments about the Dataset." ;
            sh:node dcatap_plus:KindShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcat:contactPoint ],
        [ sh:description "A geographic region that is covered by the Dataset." ;
            sh:node dcatap_plus:LocationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dcterms:spatial ],
        [ sh:description "An Agent having some form of responsibility for the resource." ;
            sh:node dcatap_plus:AttributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path prov:qualifiedAttribution ],
        [ sh:description "A language of the Dataset." ;
            sh:node dcatap_plus:LinguisticSystemShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path dcterms:language ],
        [ sh:description "The legislation that mandates the creation or management of the Dataset." ;
            sh:node dcatap_plus:LegalResourceShape ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <dcatap:applicableLegislation> ],
        [ sh:description "The frequency at which the Dataset is updated." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:FrequencyShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:accrualPeriodicity ],
        [ sh:description "An entity (organisation) responsible for making the Dataset available." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:AgentShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path dcterms:publisher ],
        [ sh:description "Information that indicates whether the Dataset is publicly accessible, has access restrictions or is not public." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:RightsStatementShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:accessRights ],
        [ sh:description "A category of the Dataset." ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path dcat:theme ],
        [ sh:description "A description of a relationship with another resource." ;
            sh:node dcatap_plus:RelationshipShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path dcat:qualifiedRelation ],
        [ sh:description "A temporal period that the Dataset covers." ;
            sh:node dcatap_plus:PeriodOfTimeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path dcterms:temporal ] ;
    sh:targetClass dcat:Dataset .

dcatap_plus:EvaluatedEntityShape a sh:NodeShape ;
    rdfs:comment "An Entity that is being evaluated in a DataGeneratingActivity." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path adms:identifier ],
        [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 5 ;
            sh:path dcterms:relation ],
        [ sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 0 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "A slot to provide a part of the Entity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( OBI:0000747 SIO:001378 prov:Entity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 9 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( OBI:0000747 SIO:001378 prov:Entity dcatap_plus:ClassifierMixin ) ] ] ] .

dcatap_plus:AgentShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Agent](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Agent)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name of the agent." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path foaf:name ],
        [ sh:description "The nature of the agent." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:ConceptShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:type ] ;
    sh:targetClass foaf:Agent .

dcatap_plus:DocumentShape a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Document](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Document)" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ] ;
    sh:targetClass foaf:Document .

dcatap_plus:EvaluatedActivityShape a sh:NodeShape ;
    rdfs:comment "An activity or process that is being evaluated in a DataGeneratingActivity." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 9 ;
            sh:path dcterms:relation ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 7 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 5 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 10 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "A slot to provide a secondary identifier of the EvaluatedActivity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:node dcatap_plus:ActivityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class SIO:010345 ] ) ;
            sh:order 4 ;
            sh:path dcterms:hasPart ],
        [ sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:node dcatap_plus:AgenticEntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class AFE:0000153 ] [ sh:class SIO:010344 ] [ sh:class SIO:010417 ] [ sh:class prov:SoftwareAgent ] ) ;
            sh:order 8 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 6 ;
            sh:path prov:generated ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 12 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( SIO:010345 prov:Activity dcatap_plus:ClassifierMixin ) ] ] ] .

<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalEntityShape> a sh:NodeShape ;
    rdfs:comment "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity." ;
    sh:property [ sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:node dcatap_plus:EntityShape ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class BFO:0000040 ] [ sh:class CHEBI:23367 ] [ sh:class CHEBI:33250 ] [ sh:class NCIT:C48810 ] [ sh:class OBI:0000747 ] [ sh:class PROCO:0000029 ] [ sh:class SIO:001378 ] [ sh:class SIO:010411 ] ) ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "has_qualitative_attribute: The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity; has_quantitative_attribute: The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:or ( [ sh:node dcatap_plus:QualitativeAttributeShape ;
                        sh:or ( [ sh:class prov:Entity ] [ sh:class CHEMINF:000018 ] [ sh:class CHEMINF:000042 ] [ sh:class CHEMINF:000059 ] [ sh:class CHEMINF:000107 ] [ sh:class CHEMINF:000113 ] ) ] [ sh:node dcatap_plus:QuantitativeAttributeShape ;
                        sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] [ sh:class CHMO:0002820 ] [ sh:class CHMO:0002855 ] [ sh:class SIO:001089 ] [ sh:class SIO:001406 ] ) ] ) ;
            sh:order 5 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:description "inchi: The slot to provide the InChi descriptor of a ChemicalEntity.; inchikey: The slot to provide the InChiKey of a ChemicalEntity.; smiles: The slot to provide the canonical SMILES descriptor of a ChemicalEntity.; molecular_formula: The slot to provide the IUPAC formula of a ChemicalEntity.; iupac_name: The slot to provide the IUPAC name of a ChemicalEntity.; has_molar_mass: The slot to provide the MolarMass of a ChemicalEntity." ;
            sh:or ( [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/InChiShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/InChIKeyShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/SMILESShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/MolecularFormulaShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/IUPACNameShape> ] [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/MolarMassShape> ] ) ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide a secondary identifier of the Entity." ;
            sh:node dcatap_plus:IdentifierShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path adms:identifier ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:node dcatap_plus:DefinedTermShape ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:description "The slot to provide the parts of a ChemicalEntity that are themself chemical entities." ;
            sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalEntityShape> ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path BFO:0000051 ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcatap_plus:id ],
        [ sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:node dcatap_plus:DefinedTermShape ] [ sh:in ( CHEBI:23367 prov:Entity dcatap_plus:ClassifierMixin ) ] ) ;
            sh:order 9 ;
            sh:path rdf:type ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:not [ sh:in ( CHEBI:23367 prov:Entity dcatap_plus:ClassifierMixin ) ] ] ] ;
    sh:targetClass CHEBI:23367 .

<https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShapeRecommendations> a sh:NodeShape ;
