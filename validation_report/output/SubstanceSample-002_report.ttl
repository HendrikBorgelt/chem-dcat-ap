            sh:resultPath SIO:000008 ;
            sh:resultSeverity sh:Warning ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Recommended: has_mass" ;
                    sh:path SIO:000008 ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:node <https://w3id.org/nfdi-de/dcat-ap-plus/materials/MassShape> ;
                            sh:or ( [ sh:class qudt:Quantity ] [ sh:class AFR:0002409 ] ) ] ;
